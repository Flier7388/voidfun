/target
flutter/rust/target/
/flutter/build/
/flutter/.dart_tool/

# Local tuwunel test server (local-server/tuwunel.toml is dev-only config,
# but the database and its log shouldn't be committed either way)
/local-server/data/
/local-server/tuwunel.log

# Reference-only clones of other matrix-rust-sdk clients, pulled in for
# research (see the project memory on `git/`) — not this project's code.
/git/

# Per-machine Claude Code settings/permissions, not project config.
/.claude/*local*

# Leftover empty marker from an earlier disk-space debugging session.
/diskcheck.txt

.idea/
*.iml
.flutter-shell-root

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt
